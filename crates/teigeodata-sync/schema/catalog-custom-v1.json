{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/teispace/teigeodata/blob/main/crates/teigeodata-sync/schema/catalog-custom-v1.json",
  "title": "teigeodata catalog: a target's custom object, schema 1",
  "description": "The pack details of one target in the signed targets metadata (D-160, D-162). The target's TUF length and hashes are the transport asset's. Unknown properties are allowed so v1 may grow; teigeodata_sync::catalog::Entry::from_target is the client's validator and also checks names against the target path and its blake3.",
  "type": "object",
  "required": [
    "schema",
    "address",
    "component",
    "release",
    "file",
    "pack",
    "transport",
    "sizes",
    "deps",
    "min_reader",
    "licence"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "address": {
      "$ref": "#/$defs/name"
    },
    "component": {
      "$ref": "#/$defs/name"
    },
    "release": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$"
    },
    "file": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}\\.[a-z0-9][a-z0-9-]{0,63}\\.[a-z0-9][a-z0-9.-]{0,63}\\.[0-9a-f]{8}\\.tgd\\.zst$"
    },
    "pack": {
      "type": "object",
      "required": [
        "length",
        "head"
      ],
      "properties": {
        "length": {
          "$ref": "#/$defs/u64"
        },
        "head": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        }
      }
    },
    "transport": {
      "type": "object",
      "required": [
        "encoding",
        "seek_table",
        "head"
      ],
      "properties": {
        "encoding": {
          "const": "zstd-seekable"
        },
        "seek_table": {
          "type": "integer",
          "minimum": 1
        },
        "head": {
          "$ref": "#/$defs/size"
        }
      }
    },
    "sizes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/size"
      }
    },
    "block_hashes": {
      "type": "object",
      "required": [
        "size",
        "for"
      ],
      "properties": {
        "size": {
          "$ref": "#/$defs/size"
        },
        "for": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/name"
          }
        }
      }
    },
    "deps": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,63}\\.[a-z0-9][a-z0-9-]{0,63}\\.tgd$"
      }
    },
    "min_reader": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535
    },
    "bbox": {
      "type": "array",
      "prefixItems": [
        {
          "$ref": "#/$defs/lon"
        },
        {
          "$ref": "#/$defs/lat"
        },
        {
          "$ref": "#/$defs/lon"
        },
        {
          "$ref": "#/$defs/lat"
        }
      ],
      "minItems": 4,
      "maxItems": 4
    },
    "licence": {
      "type": "string",
      "pattern": "^[A-Za-z0-9.+-]{1,64}$"
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "u64": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "lon": {
      "type": "integer",
      "minimum": -1800000000,
      "maximum": 1800000000
    },
    "lat": {
      "type": "integer",
      "minimum": -900000000,
      "maximum": 900000000
    },
    "size": {
      "type": "array",
      "prefixItems": [
        {
          "$ref": "#/$defs/u64"
        },
        {
          "$ref": "#/$defs/u64"
        }
      ],
      "minItems": 2,
      "maxItems": 2
    }
  }
}
