<Project Sdk="Microsoft.NET.Sdk">

  <!-- The tour of the guide, run on a released pack by `cargo xtask docs-examples`;
       the pack is its argument after the run options. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- This checkout's project; an application references the package Teispace.TeiGeodata. -->
    <ProjectReference Include="../../../bindings/dotnet/TeiGeodata/TeiGeodata.csproj" />
  </ItemGroup>

</Project>
