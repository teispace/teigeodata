":4,"1879":4,"1880":4,"1881":4,"1882":4,"1883":4,"1884":4,"1885":4,"1886":4,"1887":4,"1888":4,"1889":4,"1890":4,"1891":4,"1892":4,"1893":4,"1894":4,"1895":4,"1896":4,"1897":4,"1898":4,"1899":4,"1900":3,"1901":3,"1902":4,"1903":4,"1904":4,"1905":4,"1906":3,"1907":4,"1908":4,"1909":4,"1910":4,"1911":4,"1912":4,"1913":4,"1914":4,"1915":4,"1916":4,"1917":4,"1918":4,"1919":4,"1920":4,"1921":4,"1922":4,"1923":4,"1924":4,"1925":4,"1926":4,"1927":4,"1928":4,"1929":4,"1930":4,"1931":4,"1932":4,"1933":4,"1934":4,"1935":4,"1936":3,"1937":3,"1938":4,"1939":4,"1940":4,"1941":4,"1942":4,"1943":3,"1944":4,"1945":4,"1946":4,"1947":4,"1948":4,"1949":4,"1950":4,"1951":4,"1952":4,"1953":4,"1954":4,"1955":3,"1956":3,"1957":4,"1958":4,"1959":4,"1960":4,"1961":4,"1962":3,"1963":4,"1964":4,"1965":4,"1966":4,"1967":4,"1968":4,"1969":4,"1970":4,"1971":2,"1972":2,"1973":2,"1974":2,"1975":2,"1976":2,"1977":2,"1978":2,"1979":2,"1980":3,"1981":3,"1982":4,"1983":4,"1984":4,"1985":4,"1986":4,"1987":3,"1988":4,"1989":4,"1990":4,"1991":4,"1992":4,"1993":4,"1994":4,"1995":4,"1996":3,"1997":3,"1998":4,"1999":4,"2000":4,"2001":4,"2002":3,"2003":4,"2004":4,"2005":4,"2006":4,"2007":4,"2008":4,"2009":4,"2010":4,"2011":4,"2012":3,"2013":3,"2014":4,"2015":4,"2016":4,"2017":4,"2018":3,"2019":4,"2020":4,"2021":4,"2022":4,"2023":3,"2024":3,"2025":4,"2026":4,"2027":4,"2028":4,"2029":4,"2030":4,"2031":3,"2032":4,"2033":4,"2034":4,"2035":4,"2036":4,"2037":4,"2038":4,"2039":4,"2040":4,"2041":4,"2042":4,"2043":4,"2044":4,"2045":4,"2046":4}},"unstoredValues":{},"unstoredTerms":{}},"docs":{"docs":{"1":{"id":"/docs/cli","page_id":"/docs/cli","type":"page","content":"Command line","breadcrumbs":["teigeodata","Command line and servers"],"tags":[],"url":"/docs/cli"},"2":{"id":"/docs/cli-0","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli","content":"tgd inspects, verifies, cuts and queries packs, manages the store, and serves packs over HTTP and MCP."},"3":{"id":"/docs/cli-1","page_id":"/docs/cli","type":"heading","tags":[],"url":"/docs/cli#install","content":"Install"},"4":{"id":"/docs/cli-2","page_id":"/docs/cli","type":"heading","tags":[],"url":"/docs/cli#look-inside-a-pack","content":"Look inside a pack"},"5":{"id":"/docs/cli-3","page_id":"/docs/cli","type":"heading","tags":[],"url":"/docs/cli#search","content":"Search"},"6":{"id":"/docs/cli-4","page_id":"/docs/cli","type":"heading","tags":[],"url":"/docs/cli#a-place-by-its-id","content":"A place by its ID"},"7":{"id":"/docs/cli-5","page_id":"/docs/cli","type":"heading","tags":[],"url":"/docs/cli#from-a-point","content":"From a point"},"8":{"id":"/docs/cli-6","page_id":"/docs/cli","type":"heading","tags":[],"url":"/docs/cli#timezone-and-elevation","content":"Timezone and elevation"},"9":{"id":"/docs/cli-7","page_id":"/docs/cli","type":"heading","tags":[],"url":"/docs/cli#geojson-and-nominatim","content":"GeoJSON and Nominatim"},"10":{"id":"/docs/cli-8","page_id":"/docs/cli","type":"heading","tags":[],"url":"/docs/cli#cut-a-smaller-pack","content":"Cut a smaller pack"},"11":{"id":"/docs/cli-9","page_id":"/docs/cli","type":"heading","tags":[],"url":"/docs/cli#postal-codes","content":"Postal codes"},"12":{"id":"/docs/cli-10","page_id":"/docs/cli","type":"heading","tags":[],"url":"/docs/cli#the-store","content":"The store"},"13":{"id":"/docs/cli-11","page_id":"/docs/cli","type":"heading","tags":[],"url":"/docs/cli#serve","content":"Serve"},"14":{"id":"/docs/cli-12","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli","content":"`tgd` is the command line of teigeodata: one static binary that looks inside packs, checks them,\ncuts smaller ones, answers every query in text, JSON, GeoJSON or Nominatim's format, installs and\nupdates packs in the store, and serves them over HTTP and\nMCP."},"15":{"id":"/docs/cli-13","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli","content":"The commands below are cut from one script, tour.sh,\nwhich CI runs on the released pack `world-np-lite.tgd` and checks against the output shown."},"16":{"id":"/docs/cli-14","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#install","content":"It installs from crates.io; there are no prebuilt `tgd` binaries yet. `tgd completions zsh` (or `bash`,\n`fish`, `powershell`, `elvish`) prints a completion script."},"17":{"id":"/docs/cli-15","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#install","content":"Every query takes `--pack <file>` (repeat it for several packs). Where packs disagree, the\nlayer rule decides, not their order: the newer release, then the\nmore specific pack. Without one, it answers from the packs installed in the store."},"18":{"id":"/docs/cli-16","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#look-inside-a-pack","content":"The full listing goes on with every source's notice, every section with its component and size,\nand the bytes of each component. `tgd verify <pack>` checks the head and every section's hash\n(`--deep` also decodes every value, `--key` checks the signature); `tgd diff <old> <new>` lists\nwhat changed between two releases, section by section and place by place. `tgd delta <old> <new>\n-o <delta>` writes only the places that changed, as a pack read above the older release; it\nrefuses a pair it cannot express exactly."},"19":{"id":"/docs/cli-17","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#search","content":"A name, in any script or spelling. `-k` is how many:"},"20":{"id":"/docs/cli-18","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#search","content":"Each line is the name, the kind (and admin level), the point, the ID, the elevation with how it\nwas found (`model` from the terrain, `surveyed` from a source), the timezone and the score.\nWrite a parent after a comma to rank the places inside it first:"},"21":{"id":"/docs/cli-19","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#search","content":"`--focus lat,lon` ranks places near a point first: at the focus a place gains 30 points, and the\ngain halves every `--scale-km` (50 by default). `--strict` ranks by how well the name matched\nbefore anything else."},"22":{"id":"/docs/cli-20","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#a-place-by-its-id","content":"Every query prints JSON with `--json`: one record per place, nulls where a value is unknown."},"23":{"id":"/docs/cli-21","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#from-a-point","content":"`reverse` gives the nearest places with their distance and bearing (from the place to the point,\n\"3.2 km at 45° from Pokhara\"); `inside` marks a place that holds the point: a unit by its\noutline, a settlement or locality within its radius of the point. `--in-country` never crosses a border."},"24":{"id":"/docs/cli-22","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#from-a-point","content":"`near` does the same from a place:"},"25":{"id":"/docs/cli-23","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#from-a-point","content":"`admin` gives every unit that holds the point, country first:"},"26":{"id":"/docs/cli-24","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#timezone-and-elevation","content":"`tgd tz` also takes a place ID. The offset is computed from the tzdb rules inside the pack, at\nthe current time."},"27":{"id":"/docs/cli-25","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#geojson-and-nominatim","content":"`--geojson` prints a FeatureCollection (RFC 7946) ready for MapLibre, Leaflet or QGIS, with the\nattribution at its top level:"},"28":{"id":"/docs/cli-26","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#geojson-and-nominatim","content":"`--nominatim` prints Nominatim's `json` format, so tools written for Nominatim read the output\nunchanged:"},"29":{"id":"/docs/cli-27","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#cut-a-smaller-pack","content":"`extract` writes a pack of the places in a box (with their ancestors and timezone areas), of some\ncomponents, or both. The new pack is a normal pack: every query works on it."},"30":{"id":"/docs/cli-28","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#cut-a-smaller-pack","content":"`--components point,names` keeps only those components and what they need; with `--bbox`,\n`--lod 3` stores coarser boundaries. `tgd export <pack>` streams every place out, in the order the pack stores\nthem."},"31":{"id":"/docs/cli-29","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#postal-codes","content":"`tgd postal 44600` finds the places a code names; `--prefix` completes a partial code;\n`tgd postal <lat> <lon>` gives the codes at a point. Codes are matched with or without\nseparators, in any case and in any script's digits."},"32":{"id":"/docs/cli-30","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#the-store","content":"The store keeps installed packs and the signed catalog that says which exist. It lives in the\nplatform's data directory, or where `--store` or `TEIGEODATA_STORE` says."},"33":{"id":"/docs/cli-31","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#the-store","content":"tgd init · Set up the store: the catalog's mirrors and its trusted root.","table":"table-0"},"34":{"id":"/docs/cli-32","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#the-store","content":"tgd refresh [--countries a,b] · Fetch what changed in the catalog.","table":"table-0"},"35":{"id":"/docs/cli-33","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#the-store","content":"tgd catalog · List the catalog's packs, offline.","table":"table-0"},"36":{"id":"/docs/cli-34","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#the-store","content":"tgd find <name> · Find a place by name with the packs that hold it, offline: what to install for \"Dubai\".","table":"table-0"},"37":{"id":"/docs/cli-35","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#the-store","content":"tgd locate <lat> <lon> · The countries at a point, with their packs.","table":"table-0"},"38":{"id":"/docs/cli-36","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#the-store","content":"tgd install <packs> · Install packs and their dependencies; --components, --names and --outlines install a part.","table":"table-0"},"39":{"id":"/docs/cli-37","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#the-store","content":"tgd update · Update installed packs to the catalog's releases.","table":"table-0"},"40":{"id":"/docs/cli-38","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#the-store","content":"tgd remove, tgd pin · Remove a pack (and what nothing else needs), or keep one when room is made.","table":"table-0"},"41":{"id":"/docs/cli-39","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#the-store","content":"tgd status, tgd repair · The installed packs and their health; fetch what a damaged one lacks.","table":"table-0"},"42":{"id":"/docs/cli-40","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#the-store","content":"The store reads the live signed catalog: its addresses and the trust anchor are on\nthe store page. A pack downloaded by hand still opens with `--pack`."},"43":{"id":"/docs/cli-41","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#serve","content":"`tgd serve` answers every query over HTTP, and `tgd mcp` over MCP for AI agents: see\nHTTP server and MCP server."},"44":{"id":"/docs/concepts/accuracy","page_id":"/docs/concepts/accuracy","type":"page","content":"Accuracy","breadcrumbs":["teigeodata","Concepts"],"tags":[],"url":"/docs/concepts/accuracy"},"45":{"id":"/docs/concepts/accuracy-0","page_id":"/docs/concepts/accuracy","tags":[],"type":"text","url":"/docs/concepts/accuracy","content":"How good each kind of answer is, how it is measured and gated, and the perspective on disputed borders."},"46":{"id":"/docs/concepts/accuracy-1","page_id":"/docs/concepts/accuracy","type":"heading","tags":[],"url":"/docs/concepts/accuracy#the-order-of-importance","content":"The order of importance"},"47":{"id":"/docs/concepts/accuracy-2","page_id":"/docs/concepts/accuracy","type":"heading","tags":[],"url":"/docs/concepts/accuracy#how-heights-are-found","content":"How heights are found"},"48":{"id":"/docs/concepts/accuracy-3","page_id":"/docs/concepts/accuracy","type":"heading","tags":[],"url":"/docs/concepts/accuracy#timezones","content":"Timezones"},"49":{"id":"/docs/concepts/accuracy-4","page_id":"/docs/concepts/accuracy","type":"heading","tags":[],"url":"/docs/concepts/accuracy#boundaries-and-perspective","content":"Boundaries and perspective"},"50":{"id":"/docs/concepts/accuracy-5","page_id":"/docs/concepts/accuracy","type":"heading","tags":[],"url":"/docs/concepts/accuracy#measured-per-country","content":"Measured, per country"},"51":{"id":"/docs/concepts/accuracy-6","page_id":"/docs/concepts/accuracy","tags":[],"type":"text","url":"/docs/concepts/accuracy","content":"teigeodata's data is built to be right first, then complete. Each kind of answer has a target,\nand each target is a **gate**: a build that misses it fails, and the measured figures ship in\neach pack's summary."},"52":{"id":"/docs/concepts/accuracy-7","page_id":"/docs/concepts/accuracy","tags":[],"type":"text","url":"/docs/concepts/accuracy#the-order-of-importance","content":"**Coordinates and elevation.** A place's height is read from the terrain at its point, so the\ntwo are judged together: the target is a vertical error of at most 50 m at the 90th\npercentile. Because the height error is mostly the position error times the slope, the point\ntargets follow from it: a populated place within 500 m of its settlement core (P90) on gentle\nground and within 150 m where the slope is 5° or steeper; an admin unit's point always inside\nits own outline."},"53":{"id":"/docs/concepts/accuracy-8","page_id":"/docs/concepts/accuracy","tags":[],"type":"text","url":"/docs/concepts/accuracy#the-order-of-importance","content":"**Names.** Spellings follow each country's official sources and its lexicon, each rule with its\nsource. Search is measured on a curated set of real queries per country (golden queries) for\nhow often the right place comes first."},"54":{"id":"/docs/concepts/accuracy-9","page_id":"/docs/concepts/accuracy","tags":[],"type":"text","url":"/docs/concepts/accuracy#the-order-of-importance","content":"**Population**, where it is published. Optional values are null rather than guessed."},"55":{"id":"/docs/concepts/accuracy-10","page_id":"/docs/concepts/accuracy","tags":[],"type":"text","url":"/docs/concepts/accuracy#how-heights-are-found","content":"Every place's `elevation` is sampled from a digital elevation model at the place's point,\nbilinearly, in metres above EGM2008 (mean sea level). The source tells you how it was found:\n`model` from the terrain, `surveyed` from a source that measured it (summits keep their surveyed\nheight where it agrees with the terrain). The lite build uses NASADEM; the main build Copernicus\nGLO-30."},"56":{"id":"/docs/concepts/accuracy-11","page_id":"/docs/concepts/accuracy","tags":[],"type":"text","url":"/docs/concepts/accuracy#how-heights-are-found","content":"`elevation_at` reads the finest grid a pack has at the point: a country's 1″ grid (about 30 m)\nwhere its terrain pack is installed, and the world's coarse 15″ grid (about 460 m) everywhere\nelse. Measured on Nepal (2026-11-12), the coarse grid is within 61 m of the fine one at P90 and\n110 m at P99: enough for sunrise and sunset times, not for hiking. Install the country's `dem`\ncomponent where heights must be precise."},"57":{"id":"/docs/concepts/accuracy-12","page_id":"/docs/concepts/accuracy","tags":[],"type":"text","url":"/docs/concepts/accuracy#timezones","content":"Zones are the IANA tz database's, at the release each pack names (`tz_version`), and offsets are\ncomputed from the tzdb rules in the pack, not from the device. The lite build draws a country with\none zone over that country's outline; the main build uses the zone boundaries of\ntimezone-boundary-builder. Each build is checked against an independent source."},"58":{"id":"/docs/concepts/accuracy-13","page_id":"/docs/concepts/accuracy","tags":[],"type":"text","url":"/docs/concepts/accuracy#boundaries-and-perspective","content":"Boundaries are the official ones where they are open, stored as shared arcs so neighbouring\nunits never overlap or leave gaps. Where a boundary is disputed, teigeodata draws it from one\nstated perspective: Nepal's official map of 2020, including Kalapani, Lipulekh and Limpiyadhura.\nThe perspective is recorded in each country's profile, with its sources."},"59":{"id":"/docs/concepts/accuracy-14","page_id":"/docs/concepts/accuracy","tags":[],"type":"text","url":"/docs/concepts/accuracy#measured-per-country","content":"Every pack's summary states its rows, the sources of every field, the share of places with a\nname in each language, and the gates it passed. The data pages collect them per\ncountry and release."},"60":{"id":"/docs/concepts","page_id":"/docs/concepts","type":"page","content":"Concepts","breadcrumbs":["teigeodata","Concepts"],"tags":[],"url":"/docs/concepts"},"61":{"id":"/docs/concepts-0","page_id":"/docs/concepts","tags":[],"type":"text","url":"/docs/concepts","content":"The few ideas behind every query, in every language."},"62":{"id":"/docs/concepts-1","page_id":"/docs/concepts","tags":[],"type":"text","url":"/docs/concepts","content":"A few ideas explain everything teigeodata does. Each page is short."},"63":{"id":"/docs/concepts-2","page_id":"/docs/concepts","tags":[],"type":"text","url":"/docs/concepts","content":"<Card title=\"Places and IDs\" href=\"/docs/concepts/places\" description=\"What a place is: its kind, level, point, names and stable ID.\" />"},"64":{"id":"/docs/concepts-3","page_id":"/docs/concepts","tags":[],"type":"text","url":"/docs/concepts","content":"<Card title=\"Packs and components\" href=\"/docs/concepts/packs\" description=\"Signed, memory-mapped files; the parts you can leave out; layers that stack.\" />"},"65":{"id":"/docs/concepts-4","page_id":"/docs/concepts","tags":[],"type":"text","url":"/docs/concepts","content":"<Card title=\"Results\" href=\"/docs/concepts/results\" description=\"The columns every query returns, read in place in every language.\" />"},"66":{"id":"/docs/concepts-5","page_id":"/docs/concepts","tags":[],"type":"text","url":"/docs/concepts","content":"<Card title=\"The store\" href=\"/docs/concepts/store\" description=\"Downloading, verifying and updating packs on the user's device.\" />"},"67":{"id":"/docs/concepts-6","page_id":"/docs/concepts","tags":[],"type":"text","url":"/docs/concepts","content":"<Card title=\"Accuracy\" href=\"/docs/concepts/accuracy\" description=\"How good each answer is, how it is measured, and the perspective on borders.\" />"},"68":{"id":"/docs/concepts-7","page_id":"/docs/concepts","tags":[],"type":"text","url":"/docs/concepts","content":"<Card title=\"Licences\" href=\"/docs/concepts/licences\" description=\"What you may do with the data and what you must credit.\" />"},"69":{"id":"/docs/concepts/licences","page_id":"/docs/concepts/licences","type":"page","content":"Licences","breadcrumbs":["teigeodata","Concepts"],"tags":[],"url":"/docs/concepts/licences"},"70":{"id":"/docs/concepts/licences-0","page_id":"/docs/concepts/licences","tags":[],"type":"text","url":"/docs/concepts/licences","content":"Apache-2.0 code, ODbL and CC BY 4.0 data, and what you must credit when you ship a pack or show its answers."},"71":{"id":"/docs/concepts/licences-1","page_id":"/docs/concepts/licences","type":"heading","tags":[],"url":"/docs/concepts/licences#the-code","content":"The code"},"72":{"id":"/docs/concepts/licences-2","page_id":"/docs/concepts/licences","type":"heading","tags":[],"url":"/docs/concepts/licences#the-data-two-builds","content":"The data: two builds"},"73":{"id":"/docs/concepts/licences-3","page_id":"/docs/concepts/licences","type":"heading","tags":[],"url":"/docs/concepts/licences#you-may-keep-it","content":"You may keep it"},"74":{"id":"/docs/concepts/licences-4","page_id":"/docs/concepts/licences","type":"heading","tags":[],"url":"/docs/concepts/licences#attribution","content":"Attribution"},"75":{"id":"/docs/concepts/licences-5","page_id":"/docs/concepts/licences","tags":[],"type":"text","url":"/docs/concepts/licences#the-code","content":"All code (the engine, the bindings, the command line, the servers, the forge) is under the\nApache License 2.0: use it in open\nand closed software alike, keep the notices."},"76":{"id":"/docs/concepts/licences-6","page_id":"/docs/concepts/licences","tags":[],"type":"text","url":"/docs/concepts/licences#the-data-two-builds","content":"Every pack comes in one of two builds, built from the same schema with the same IDs:"},"77":{"id":"/docs/concepts/licences-7","page_id":"/docs/concepts/licences","tags":[],"type":"text","url":"/docs/concepts/licences#the-data-two-builds","content":"Licence · ODbL 1.0 · CC BY 4.0","table":"table-0"},"78":{"id":"/docs/concepts/licences-8","page_id":"/docs/concepts/licences","tags":[],"type":"text","url":"/docs/concepts/licences#the-data-two-builds","content":"Sources · Open sources, OpenStreetMap included (no other share-alike, nothing non-commercial) · Only public-domain and attribution-only sources (clean room)","table":"table-0"},"79":{"id":"/docs/concepts/licences-9","page_id":"/docs/concepts/licences","tags":[],"type":"text","url":"/docs/concepts/licences#the-data-two-builds","content":"You must · Credit the sources; share improvements to the database you distribute · Credit the sources","table":"table-0"},"80":{"id":"/docs/concepts/licences-10","page_id":"/docs/concepts/licences","tags":[],"type":"text","url":"/docs/concepts/licences#the-data-two-builds","content":"Best for · The most complete data · Apps that cannot take on share-alike terms","table":"table-0"},"81":{"id":"/docs/concepts/licences-11","page_id":"/docs/concepts/licences","tags":[],"type":"text","url":"/docs/concepts/licences#the-data-two-builds","content":"The lite build is **clean room**: its pipeline refuses share-alike, non-commercial and\nproprietary sources at ingest, before any step reads them, and a licence gate fails a build\nwhose provenance includes one. The rules are in\nCLEAN_ROOM.md."},"82":{"id":"/docs/concepts/licences-12","page_id":"/docs/concepts/licences","tags":[],"type":"text","url":"/docs/concepts/licences#you-may-keep-it","content":"Commercial geocoding APIs limit how long you may store their answers. teigeodata's data is yours\nto store, cache, ship inside apps and redistribute, under the build's licence. There are no\nper-request terms and no keys."},"83":{"id":"/docs/concepts/licences-13","page_id":"/docs/concepts/licences","tags":[],"type":"text","url":"/docs/concepts/licences#attribution","content":"Every pack carries the notices of its sources, and every answer can show them:"},"84":{"id":"/docs/concepts/licences-14","page_id":"/docs/concepts/licences","tags":[],"type":"text","url":"/docs/concepts/licences#attribution","content":"`tgd inspect` lists a pack's notices, and `/packs` on the HTTP server returns them."},"85":{"id":"/docs/concepts/licences-15","page_id":"/docs/concepts/licences","tags":[],"type":"text","url":"/docs/concepts/licences#attribution","content":"Every HTTP and MCP answer carries an `attribution` (the `licence` field in Nominatim's\nformat), built from the packs that answered."},"86":{"id":"/docs/concepts/licences-16","page_id":"/docs/concepts/licences","tags":[],"type":"text","url":"/docs/concepts/licences#attribution","content":"In an app, show the notices where you show the data, as you would map credits: an \"About\" or\n\"Data sources\" screen is usual. The world lite pack's notices today:"},"87":{"id":"/docs/concepts/licences-17","page_id":"/docs/concepts/licences","tags":[],"type":"text","url":"/docs/concepts/licences#attribution","content":"Credit the build's licence with them: each pack states it (`licence: \"cc-by-4.0\"` in\n`tgd inspect` for a lite pack)."},"88":{"id":"/docs/concepts/mirrors","page_id":"/docs/concepts/mirrors","type":"page","content":"Running a mirror","breadcrumbs":["teigeodata","Concepts"],"tags":[],"url":"/docs/concepts/mirrors"},"89":{"id":"/docs/concepts/mirrors-0","page_id":"/docs/concepts/mirrors","tags":[],"type":"text","url":"/docs/concepts/mirrors","content":"Serve teigeodata's signed catalog and packs from your own host, for browser apps, private networks or speed. Trust never depends on the mirror."},"90":{"id":"/docs/concepts/mirrors-1","page_id":"/docs/concepts/mirrors","type":"heading","tags":[],"url":"/docs/concepts/mirrors#what-a-mirror-serves","content":"What a mirror serves"},"91":{"id":"/docs/concepts/mirrors-2","page_id":"/docs/concepts/mirrors","type":"heading","tags":[],"url":"/docs/concepts/mirrors#what-the-host-must-do","content":"What the host must do"},"92":{"id":"/docs/concepts/mirrors-3","page_id":"/docs/concepts/mirrors","type":"heading","tags":[],"url":"/docs/concepts/mirrors#keeping-it-current","content":"Keeping it current"},"93":{"id":"/docs/concepts/mirrors-4","page_id":"/docs/concepts/mirrors","type":"heading","tags":[],"url":"/docs/concepts/mirrors#example-configurations","content":"Example configurations"},"94":{"id":"/docs/concepts/mirrors-5","page_id":"/docs/concepts/mirrors","type":"heading","tags":[],"url":"/docs/concepts/mirrors#checking-a-mirror","content":"Checking a mirror"},"95":{"id":"/docs/concepts/mirrors-6","page_id":"/docs/concepts/mirrors","tags":[],"type":"text","url":"/docs/concepts/mirrors","content":"A **mirror** serves the same files as teigeodata's own hosts: the signed catalog's metadata\nand the packs' assets. Apps check every byte against the catalog's signatures and hashes, so a\nmirror needs no trust and holds no key. A mirror that serves a wrong or old file is refused and\nthe store moves to the next one."},"96":{"id":"/docs/concepts/mirrors-7","page_id":"/docs/concepts/mirrors","tags":[],"type":"text","url":"/docs/concepts/mirrors","content":"Run one when:"},"97":{"id":"/docs/concepts/mirrors-8","page_id":"/docs/concepts/mirrors","tags":[],"type":"text","url":"/docs/concepts/mirrors","content":"**Browser apps** need the packs: GitHub's release assets send no CORS headers, so a page\ncannot read them."},"98":{"id":"/docs/concepts/mirrors-9","page_id":"/docs/concepts/mirrors","tags":[],"type":"text","url":"/docs/concepts/mirrors","content":"**A private network** has no route to GitHub, or the app should not reach out to it."},"99":{"id":"/docs/concepts/mirrors-10","page_id":"/docs/concepts/mirrors","tags":[],"type":"text","url":"/docs/concepts/mirrors","content":"**Speed or quota**: a host near your users, or one you already pay for."},"100":{"id":"/docs/concepts/mirrors-11","page_id":"/docs/concepts/mirrors","tags":[],"type":"text","url":"/docs/concepts/mirrors","content":"The signed catalog is live since 2026-11-23 (SDK 1.2 or later): the metadata at\n`https://raw.githubusercontent.com/teispace/teigeodata/catalog/main/` and `…/lite/`, the assets under\n`https://github.com/teispace/teigeodata/releases/download/`. A mirror copies both."},"101":{"id":"/docs/concepts/mirrors-12","page_id":"/docs/concepts/mirrors","tags":[],"type":"text","url":"/docs/concepts/mirrors#what-a-mirror-serves","content":"Two bases, which may be one host or two. A store is set up with a list of each\n(`tgd init`, `Store.create`, or `init` in the browser) and tries them in\norder."},"102":{"id":"/docs/concepts/mirrors-13","page_id":"/docs/concepts/mirrors","tags":[],"type":"text","url":"/docs/concepts/mirrors#what-a-mirror-serves","content":"**The metadata** (the `repo` base), flat under it:"},"103":{"id":"/docs/concepts/mirrors-14","page_id":"/docs/concepts/mirrors","tags":[],"type":"text","url":"/docs/concepts/mirrors#what-a-mirror-serves","content":"timestamp.json · the newest timestamp: names the snapshot; re-signed daily · a few minutes at most","table":"table-0"},"104":{"id":"/docs/concepts/mirrors-15","page_id":"/docs/concepts/mirrors","tags":[],"type":"text","url":"/docs/concepts/mirrors#what-a-mirror-serves","content":"N.root.json · each root, by version (1.root.json, 2.root.json, …) · forever","table":"table-0"},"105":{"id":"/docs/concepts/mirrors-16","page_id":"/docs/concepts/mirrors","tags":[],"type":"text","url":"/docs/concepts/mirrors#what-a-mirror-serves","content":"V.snapshot.json · each snapshot, by version · forever","table":"table-0"},"106":{"id":"/docs/concepts/mirrors-17","page_id":"/docs/concepts/mirrors","tags":[],"type":"text","url":"/docs/concepts/mirrors#what-a-mirror-serves","content":"V.targets.json · each top-level targets, by version · forever","table":"table-0"},"107":{"id":"/docs/concepts/mirrors-18","page_id":"/docs/concepts/mirrors","tags":[],"type":"text","url":"/docs/concepts/mirrors#what-a-mirror-serves","content":"V.<role>.json · each country's delegated role, by version (3.np.json) · forever","table":"table-0"},"108":{"id":"/docs/concepts/mirrors-19","page_id":"/docs/concepts/mirrors","tags":[],"type":"text","url":"/docs/concepts/mirrors#what-a-mirror-serves","content":"A store reads `timestamp.json`, then only the versioned files it names. A file that is not\nthere is a `404`; a store looks for the next root (`N+1.root.json`) on every refresh, and the\n`404` tells it there is none."},"109":{"id":"/docs/concepts/mirrors-20","page_id":"/docs/concepts/mirrors","tags":[],"type":"text","url":"/docs/concepts/mirrors#what-a-mirror-serves","content":"**The assets** (the `assets` base), one per pack and release, at the path the catalog names:\nthe asset's name, or one folder and its name. teigeodata's own catalog puts each release's\nassets in a folder, the GitHub release that holds them; a mirror keeps that folder."},"110":{"id":"/docs/concepts/mirrors-21","page_id":"/docs/concepts/mirrors","tags":[],"type":"text","url":"/docs/concepts/mirrors#what-a-mirror-serves","content":"A name is never reused for other bytes, so every asset can be cached forever."},"111":{"id":"/docs/concepts/mirrors-22","page_id":"/docs/concepts/mirrors","tags":[],"type":"text","url":"/docs/concepts/mirrors#what-the-host-must-do","content":"**Metadata** answers `200` with the whole file. `Content-Encoding: gzip` is fine: the store\ndecodes it and caps a file's size after decoding."},"112":{"id":"/docs/concepts/mirrors-23","page_id":"/docs/concepts/mirrors","tags":[],"type":"text","url":"/docs/concepts/mirrors#what-the-host-must-do","content":"**Assets** answer a `Range: bytes=a-b` request with `206 Partial Content`, a\n`Content-Range` that matches the request, and exactly those bytes. A `200` to a ranged\nrequest is refused. The store asks for `Accept-Encoding: identity`; do not compress assets."},"113":{"id":"/docs/concepts/mirrors-24","page_id":"/docs/concepts/mirrors","tags":[],"type":"text","url":"/docs/concepts/mirrors#what-the-host-must-do","content":"**One `ETag` per asset.** An install checks that every range comes from the same asset (no\n`If-Range` is needed); a host that sends no `ETag` still works, held to the asset's length\nand hashes."},"114":{"id":"/docs/concepts/mirrors-25","page_id":"/docs/concepts/mirrors","tags":[],"type":"text","url":"/docs/concepts/mirrors#what-the-host-must-do","content":"**Redirects** are followed with the `Range` header kept, so an object store behind a\nredirect works."},"115":{"id":"/docs/concepts/mirrors-26","page_id":"/docs/concepts/mirrors","tags":[],"type":"text","url":"/docs/concepts/mirrors#what-the-host-must-do","content":"**For browser apps** on another origin: `Access-Control-Allow-Origin` for the app's origin\n(or `*`) on both bases, and `Access-Control-Expose-Headers: Content-Range, ETag`. A\n`Range` request needs no preflight."},"116":{"id":"/docs/concepts/mirrors-27","page_id":"/docs/concepts/mirrors","tags":[],"type":"text","url":"/docs/concepts/mirrors#keeping-it-current","content":"Copy the catalog's metadata and the release assets, metadata last:"},"117":{"id":"/docs/concepts/mirrors-28","page_id":"/docs/concepts/mirrors","tags":[],"type":"text","url":"/docs/concepts/mirrors#keeping-it-current","content":"Copy every asset not already on the mirror, in its folder (assets are immutable, so a\ncopy never replaces one)."},"118":{"id":"/docs/concepts/mirrors-29","page_id":"/docs/concepts/mirrors","tags":[],"type":"text","url":"/docs/concepts/mirrors#keeping-it-current","content":"Copy the versioned metadata files (`*.root.json`, `*.snapshot.json`, `*.targets.json`,\n`*.<role>.json`)."},"119":{"id":"/docs/concepts/mirrors-30","page_id":"/docs/concepts/mirrors","tags":[],"type":"text","url":"/docs/concepts/mirrors#keeping-it-current","content":"Copy `timestamp.json` last. It is the commit point: a store that reads the new timestamp\nfinds every file it names already there."},"120":{"id":"/docs/concepts/mirrors-31","page_id":"/docs/concepts/mirrors","tags":[],"type":"text","url":"/docs/concepts/mirrors#keeping-it-current","content":"The timestamp is re-signed every day and expires in 14 days, so sync at least daily (hourly is\nbetter). A mirror that stops syncing becomes stale, and stores refuse its timestamp once it has\nexpired, then use the next mirror. Old files may stay; removing them is optional."},"121":{"id":"/docs/concepts/mirrors-32","page_id":"/docs/concepts/mirrors","tags":[],"type":"text","url":"/docs/concepts/mirrors#example-configurations","content":"nginx serves ranges and an `ETag` for static files by default:"},"122":{"id":"/docs/concepts/mirrors-33","page_id":"/docs/concepts/mirrors","tags":[],"type":"text","url":"/docs/concepts/mirrors#example-configurations","content":"Caddy:"},"123":{"id":"/docs/concepts/mirrors-34","page_id":"/docs/concepts/mirrors","tags":[],"type":"text","url":"/docs/concepts/mirrors#example-configurations","content":"An object store (S3, R2, GCS) serves ranges itself; set a CORS rule that allows `GET` from\nyour app's origins and exposes `Content-Range` and `ETag`."},"124":{"id":"/docs/concepts/mirrors-35","page_id":"/docs/concepts/mirrors","tags":[],"type":"text","url":"/docs/concepts/mirrors#checking-a-mirror","content":"Set up a scratch store against it and read the catalog through it:"},"125":{"id":"/docs/concepts/mirrors-36","page_id":"/docs/concepts/mirrors","tags":[],"type":"text","url":"/docs/concepts/mirrors#checking-a-mirror","content":"`refresh` checks the whole signed chain and `install` every byte of the pack; `status --deep`\nreads the installed file back against its hashes. For browser apps, also open a page on the\napp's origin and install from there: CORS problems show only in a browser."},"126":{"id":"/docs/concepts/packs","page_id":"/docs/concepts/packs","type":"page","content":"Packs and components","breadcrumbs":["teigeodata","Concepts"],"tags":[],"url":"/docs/concepts/packs"},"127":{"id":"/docs/concepts/packs-0","page_id":"/docs/concepts/packs","tags":[],"type":"text","url":"/docs/concepts/packs","content":"What is inside a pack, how it is verified, the components you can leave out, and how packs stack as layers."},"128":{"id":"/docs/concepts/packs-1","page_id":"/docs/concepts/packs","type":"heading","tags":[],"url":"/docs/concepts/packs#built-to-be-mapped","content":"Built to be mapped"},"129":{"id":"/docs/concepts/packs-2","page_id":"/docs/concepts/packs","type":"heading","tags":[],"url":"/docs/concepts/packs#components","content":"Components"},"130":{"id":"/docs/concepts/packs-3","page_id":"/docs/concepts/packs","type":"heading","tags":[],"url":"/docs/concepts/packs#layers","content":"Layers"},"131":{"id":"/docs/concepts/packs-4","page_id":"/docs/concepts/packs","type":"heading","tags":[],"url":"/docs/concepts/packs#where-packs-come-from","content":"Where packs come from"},"132":{"id":"/docs/concepts/packs-5","page_id":"/docs/concepts/packs","tags":[],"type":"text","url":"/docs/concepts/packs","content":"A **pack** is one file (`.tgd`) of places and everything known about them: names, heights, the\nhierarchy, boundaries, timezones, postal codes and the search index. Packs are built by the\nforge from open sources, signed, and published in releases."},"133":{"id":"/docs/concepts/packs-6","page_id":"/docs/concepts/packs","tags":[],"type":"text","url":"/docs/concepts/packs#built-to-be-mapped","content":"A pack is laid out to be read where it lies: the engine memory-maps the file and reads the bytes\nit needs, with no parsing step and no copy into the heap. Opening a 15 MB pack reads its head\n(at most 16 KiB) and proves the block hashes of its large sections, and nothing else; a query touches only the pages it reads, which the operating\nsystem shares between processes and drops under memory pressure."},"134":{"id":"/docs/concepts/packs-7","page_id":"/docs/concepts/packs","tags":[],"type":"text","url":"/docs/concepts/packs#built-to-be-mapped","content":"**Verified as it is read.** Every section carries a BLAKE3 hash in the head, and every 16 KiB\nblock of a large section has its own. By default a section, or a block, is checked the first\ntime a query reads it (`Verify::Lazy`); `Eager` checks everything when the pack opens."},"135":{"id":"/docs/concepts/packs-8","page_id":"/docs/concepts/packs","tags":[],"type":"text","url":"/docs/concepts/packs#built-to-be-mapped","content":"**Signed.** Released packs are signed with Ed25519 over the head, which holds every section's\nhash. `tgd verify --key` checks a signature; the store checks every pack it installs against\nthe signed catalog. A pack downloaded by hand from a data release is checked by the SHA-256\nits release lists."},"136":{"id":"/docs/concepts/packs-9","page_id":"/docs/concepts/packs","tags":[],"type":"text","url":"/docs/concepts/packs#built-to-be-mapped","content":"**Forward compatible.** A reader skips sections it does not know, so older code keeps reading\nnewer packs, and a pack states the oldest reader that can open it."},"137":{"id":"/docs/concepts/packs-10","page_id":"/docs/concepts/packs","tags":[],"type":"text","url":"/docs/concepts/packs#components","content":"A pack is cut into **components**, each a set of sections. Install, download or link only the\nones your app uses; a query that needs a component you left out fails with `MissingComponent`\ninstead of answering wrongly."},"138":{"id":"/docs/concepts/packs-11","page_id":"/docs/concepts/packs","tags":[],"type":"text","url":"/docs/concepts/packs#components","content":"point · IDs, coordinates, kinds, the spatial index and retired IDs","table":"table-0"},"139":{"id":"/docs/concepts/packs-12","page_id":"/docs/concepts/packs","tags":[],"type":"text","url":"/docs/concepts/packs#components","content":"names · Every name of every place · point","table":"table-0"},"140":{"id":"/docs/concepts/packs-13","page_id":"/docs/concepts/packs","tags":[],"type":"text","url":"/docs/concepts/packs#components","content":"search · The name search index · names","table":"table-0"},"141":{"id":"/docs/concepts/packs-14","page_id":"/docs/concepts/packs","tags":[],"type":"text","url":"/docs/concepts/packs#components","content":"substring · Search from three or more characters inside a word · search","table":"table-0"},"142":{"id":"/docs/concepts/packs-15","page_id":"/docs/concepts/packs","tags":[],"type":"text","url":"/docs/concepts/packs#components","content":"admin · Parents, children and ISO 3166 codes · point","table":"table-0"},"143":{"id":"/docs/concepts/packs-16","page_id":"/docs/concepts/packs","tags":[],"type":"text","url":"/docs/concepts/packs#components","content":"boundaries · The outlines of admin units, as shared arcs · point","table":"table-0"},"144":{"id":"/docs/concepts/packs-17","page_id":"/docs/concepts/packs","tags":[],"type":"text","url":"/docs/concepts/packs#components","content":"admin-index · The admin units at any point · boundaries","table":"table-0"},"145":{"id":"/docs/concepts/packs-18","page_id":"/docs/concepts/packs","tags":[],"type":"text","url":"/docs/concepts/packs#components","content":"elevation · Each place's height · point","table":"table-0"},"146":{"id":"/docs/concepts/packs-19","page_id":"/docs/concepts/packs","tags":[],"type":"text","url":"/docs/concepts/packs#components","content":"dem, dem-coarse · Elevation grids: a country's terrain, and a coarse grid of the world","table":"table-0"},"147":{"id":"/docs/concepts/packs-20","page_id":"/docs/concepts/packs","tags":[],"type":"text","url":"/docs/concepts/packs#components","content":"timezone · Each place's timezone · point, tz-rules","table":"table-0"},"148":{"id":"/docs/concepts/packs-21","page_id":"/docs/concepts/packs","tags":[],"type":"text","url":"/docs/concepts/packs#components","content":"timezone-index · The timezone at any point · point, tz-rules","table":"table-0"},"149":{"id":"/docs/concepts/packs-22","page_id":"/docs/concepts/packs","tags":[],"type":"text","url":"/docs/concepts/packs#components","content":"tz-rules · The tzdb rules: offsets at any instant, local times","table":"table-0"},"150":{"id":"/docs/concepts/packs-23","page_id":"/docs/concepts/packs","tags":[],"type":"text","url":"/docs/concepts/packs#components","content":"postal · Postal codes, current and former · point","table":"table-0"},"151":{"id":"/docs/concepts/packs-24","page_id":"/docs/concepts/packs","tags":[],"type":"text","url":"/docs/concepts/packs#components","content":"extra · Optional fields and cold data · point","table":"table-0"},"152":{"id":"/docs/concepts/packs-25","page_id":"/docs/concepts/packs","tags":[],"type":"text","url":"/docs/concepts/packs#components","content":"The world lite pack, by component (disk and compressed wire bytes, `data-2026.11.14.3`):"},"153":{"id":"/docs/concepts/packs-26","page_id":"/docs/concepts/packs","tags":[],"type":"text","url":"/docs/concepts/packs#components","content":"point · 1.60 MB · 1.06 MB · 1.06 MB","table":"table-1"},"154":{"id":"/docs/concepts/packs-27","page_id":"/docs/concepts/packs","tags":[],"type":"text","url":"/docs/concepts/packs#components","content":"elevation · 0.32 MB · 0.23 MB · 1.29 MB","table":"table-1"},"155":{"id":"/docs/concepts/packs-28","page_id":"/docs/concepts/packs","tags":[],"type":"text","url":"/docs/concepts/packs#components","content":"admin · 0.71 MB · 0.28 MB · 1.34 MB","table":"table-1"},"156":{"id":"/docs/concepts/packs-29","page_id":"/docs/concepts/packs","tags":[],"type":"text","url":"/docs/concepts/packs#components","content":"names · 4.60 MB · 1.83 MB · 2.91 MB","table":"table-1"},"157":{"id":"/docs/concepts/packs-30","page_id":"/docs/concepts/packs","tags":[],"type":"text","url":"/docs/concepts/packs#components","content":"search · 4.47 MB · 2.91 MB · 5.81 MB","table":"table-1"},"158":{"id":"/docs/concepts/packs-31","page_id":"/docs/concepts/packs","tags":[],"type":"text","url":"/docs/concepts/packs#components","content":"timezone · 0.06 MB · 0.01 MB · 1.14 MB","table":"table-1"},"159":{"id":"/docs/concepts/packs-32","page_id":"/docs/concepts/packs","tags":[],"type":"text","url":"/docs/concepts/packs#components","content":"boundaries · 2.19 MB · 2.03 MB · 3.11 MB","table":"table-1"},"160":{"id":"/docs/concepts/packs-33","page_id":"/docs/concepts/packs","tags":[],"type":"text","url":"/docs/concepts/packs#components","content":"admin-index · 1.07 MB · 0.80 MB · 3.91 MB","table":"table-1"},"161":{"id":"/docs/concepts/packs-34","page_id":"/docs/concepts/packs","tags":[],"type":"text","url":"/docs/concepts/packs#components","content":"tz-rules · 0.08 MB · 0.06 MB · 0.07 MB","table":"table-1"},"162":{"id":"/docs/concepts/packs-35","page_id":"/docs/concepts/packs","tags":[],"type":"text","url":"/docs/concepts/packs#components","content":"dem-coarse · 0.53 MB · 0.52 MB · 0.52 MB","table":"table-1"},"163":{"id":"/docs/concepts/packs-36","page_id":"/docs/concepts/packs","tags":[],"type":"text","url":"/docs/concepts/packs#components","content":"So an app that only finds the nearest named place to a point needs `point` and `names`: 2.9 MB\non the wire instead of 9.8 MB. The libraries are cut the same way: each language's build can leave out the code of\ncomponents it does not use (the WebAssembly package has a smaller `-lookup` build without name\nsearch)."},"164":{"id":"/docs/concepts/packs-37","page_id":"/docs/concepts/packs","tags":[],"type":"text","url":"/docs/concepts/packs#components","content":"A pack also splits **by language** (install the names of up to eight languages besides the base\nnames) and **by outline detail** (install a country's boundaries down to a level, simplified to\na tolerance in metres). `OpenOptions` and the store's install options take the same choices."},"165":{"id":"/docs/concepts/packs-38","page_id":"/docs/concepts/packs","tags":[],"type":"text","url":"/docs/concepts/packs#layers","content":"An engine answers from several packs at once; each is a **layer**. Where layers hold the same\nplace, one rule decides which answers: the higher `priority` you give, then the newer release,\nthen the more specific pack (a country over the world), then the pack's address as a last\ntie-break, and the baseline always last. So a\ndetailed country pack overrides the world pack inside that country, while the world pack still\nanswers everywhere else. The answers do not depend on the order the packs were added (a CI gate\nsplits packs and compares). Typical stacks:"},"166":{"id":"/docs/concepts/packs-39","page_id":"/docs/concepts/packs","tags":[],"type":"text","url":"/docs/concepts/packs#layers","content":"**One world pack** bundled with the app: every country, its first-level units and its cities,\nand the full detail of the countries you serve."},"167":{"id":"/docs/concepts/packs-40","page_id":"/docs/concepts/packs","tags":[],"type":"text","url":"/docs/concepts/packs#layers","content":"**A world baseline plus country packs** downloaded on demand: the user opens \"Dubai\", the\napp installs the UAE pack, and the engine answers from both."},"168":{"id":"/docs/concepts/packs-41","page_id":"/docs/concepts/packs","tags":[],"type":"text","url":"/docs/concepts/packs#layers","content":"**Terrain packs** (`dem`) added over the coarse world grid where heights must be precise."},"169":{"id":"/docs/concepts/packs-42","page_id":"/docs/concepts/packs","tags":[],"type":"text","url":"/docs/concepts/packs#layers","content":"Layers can be added and removed while other threads query: each change publishes a new snapshot,\nand queries already running finish on the one they started with."},"170":{"id":"/docs/concepts/packs-43","page_id":"/docs/concepts/packs","tags":[],"type":"text","url":"/docs/concepts/packs#where-packs-come-from","content":"The store finds, downloads, verifies and updates packs for you from the\nlive signed catalog, which lists each pack's releases and the deltas between them. Every pack is\nalso in a data release on GitHub, with checksums, to download and open by hand."},"171":{"id":"/docs/concepts/places","page_id":"/docs/concepts/places","type":"page","content":"Places and IDs","breadcrumbs":["teigeodata","Concepts"],"tags":[],"url":"/docs/concepts/places"},"172":{"id":"/docs/concepts/places-0","page_id":"/docs/concepts/places","tags":[],"type":"text","url":"/docs/concepts/places","content":"What a place is in teigeodata, its kinds and admin levels, and why its ID never changes."},"173":{"id":"/docs/concepts/places-1","page_id":"/docs/concepts/places","type":"heading","tags":[],"url":"/docs/concepts/places#kinds","content":"Kinds"},"174":{"id":"/docs/concepts/places-2","page_id":"/docs/concepts/places","type":"heading","tags":[],"url":"/docs/concepts/places#admin-levels","content":"Admin levels"},"175":{"id":"/docs/concepts/places-3","page_id":"/docs/concepts/places","type":"heading","tags":[],"url":"/docs/concepts/places#ids-that-last","content":"IDs that last"},"176":{"id":"/docs/concepts/places-4","page_id":"/docs/concepts/places","type":"heading","tags":[],"url":"/docs/concepts/places#names-in-every-script","content":"Names in every script"},"177":{"id":"/docs/concepts/places-5","page_id":"/docs/concepts/places","tags":[],"type":"text","url":"/docs/concepts/places","content":"Everything teigeodata answers is about **places**. A place has:"},"178":{"id":"/docs/concepts/places-6","page_id":"/docs/concepts/places","tags":[],"type":"text","url":"/docs/concepts/places","content":"id · A stable ID, such as tgd:np/1xhb.","table":"table-0"},"179":{"id":"/docs/concepts/places-7","page_id":"/docs/concepts/places","tags":[],"type":"text","url":"/docs/concepts/places","content":"name · Its name in the pack's base language, with every other name it has (other scripts, languages, former and alternative names) behind it for search.","table":"table-0"},"180":{"id":"/docs/concepts/places-8","page_id":"/docs/concepts/places","tags":[],"type":"text","url":"/docs/concepts/places","content":"kind · What sort of place it is (below).","table":"table-0"},"181":{"id":"/docs/concepts/places-9","page_id":"/docs/concepts/places","tags":[],"type":"text","url":"/docs/concepts/places","content":"level · For an admin unit, its admin level; 0 for a country and for anything that is not a unit.","table":"table-0"},"182":{"id":"/docs/concepts/places-10","page_id":"/docs/concepts/places","tags":[],"type":"text","url":"/docs/concepts/places","content":"lat, lon · Its point in WGS84 degrees: the centre of a settlement, a label point for a unit.","table":"table-0"},"183":{"id":"/docs/concepts/places-11","page_id":"/docs/concepts/places","tags":[],"type":"text","url":"/docs/concepts/places","content":"elevation · Metres above mean sea level (EGM2008), with how it was found: surveyed from a source, model from the terrain.","table":"table-0"},"184":{"id":"/docs/concepts/places-12","page_id":"/docs/concepts/places","tags":[],"type":"text","url":"/docs/concepts/places","content":"parent · The ID of the smallest unit that holds it.","table":"table-0"},"185":{"id":"/docs/concepts/places-13","page_id":"/docs/concepts/places","tags":[],"type":"text","url":"/docs/concepts/places","content":"tz · Its IANA timezone.","table":"table-0"},"186":{"id":"/docs/concepts/places-14","page_id":"/docs/concepts/places","tags":[],"type":"text","url":"/docs/concepts/places","content":"iso · The ISO 3166 code of a country (NP) or a subdivision (NP-P4).","table":"table-0"},"187":{"id":"/docs/concepts/places-15","page_id":"/docs/concepts/places","tags":[],"type":"text","url":"/docs/concepts/places","content":"population · Its number of people, with where it came from: stated by a source (a census or an estimate), or modelled from a population grid over an admin unit.","table":"table-0"},"188":{"id":"/docs/concepts/places-16","page_id":"/docs/concepts/places","tags":[],"type":"text","url":"/docs/concepts/places","content":"Any of these but the ID and point may be null where the data has no value; `kind` is null only\nfor a kind newer than the reader."},"189":{"id":"/docs/concepts/places-17","page_id":"/docs/concepts/places","tags":[],"type":"text","url":"/docs/concepts/places#kinds","content":"country · A country.","table":"table-1"},"190":{"id":"/docs/concepts/places-18","page_id":"/docs/concepts/places","tags":[],"type":"text","url":"/docs/concepts/places#kinds","content":"admin · An admin unit: a province, a district, a municipality, a ward. Its level says which.","table":"table-1"},"191":{"id":"/docs/concepts/places-19","page_id":"/docs/concepts/places","tags":[],"type":"text","url":"/docs/concepts/places#kinds","content":"settlement · A city, town or village: where people live, whether or not it is a unit.","table":"table-1"},"192":{"id":"/docs/concepts/places-20","page_id":"/docs/concepts/places","tags":[],"type":"text","url":"/docs/concepts/places#kinds","content":"locality · A named part of a settlement: a neighbourhood, a tole, a chowk.","table":"table-1"},"193":{"id":"/docs/concepts/places-21","page_id":"/docs/concepts/places","tags":[],"type":"text","url":"/docs/concepts/places#kinds","content":"natural · A mountain, lake, river or other natural feature.","table":"table-1"},"194":{"id":"/docs/concepts/places-22","page_id":"/docs/concepts/places","tags":[],"type":"text","url":"/docs/concepts/places#kinds","content":"postal_area · The area of a postal code.","table":"table-1"},"195":{"id":"/docs/concepts/places-23","page_id":"/docs/concepts/places","tags":[],"type":"text","url":"/docs/concepts/places#kinds","content":"timezone_area · An area with one IANA timezone; its name is the zone.","table":"table-1"},"196":{"id":"/docs/concepts/places-24","page_id":"/docs/concepts/places","tags":[],"type":"text","url":"/docs/concepts/places#admin-levels","content":"Countries divide themselves differently, so each country's ladder is data: its\nprofile names each level.\nNepal's is country (0), province (1), district (2), local level (3, the municipality) and ward\n(4). Code never assumes a ladder: ask for a place's `level` and its ancestors."},"197":{"id":"/docs/concepts/places-25","page_id":"/docs/concepts/places","tags":[],"type":"text","url":"/docs/concepts/places#ids-that-last","content":"An ID is the country that first allocated it and a serial: `tgd:np/1xhb` is Nepal's serial\n`1xhb` in base32. IDs are allocated once and never reused, so you can store them in your\ndatabase and look them up after any data update:"},"198":{"id":"/docs/concepts/places-26","page_id":"/docs/concepts/places","tags":[],"type":"text","url":"/docs/concepts/places#ids-that-last","content":"A place keeps its ID through every rebuild, however its name, point or parent change."},"199":{"id":"/docs/concepts/places-27","page_id":"/docs/concepts/places","tags":[],"type":"text","url":"/docs/concepts/places#ids-that-last","content":"When two records turn out to be one place, the survivor keeps its ID and the other is\n**retired**: looking up a retired ID answers with the survivor."},"200":{"id":"/docs/concepts/places-28","page_id":"/docs/concepts/places","tags":[],"type":"text","url":"/docs/concepts/places#ids-that-last","content":"A place that moves to another country keeps the ID it was born with: the prefix is where the ID\nwas allocated, not where the place is now."},"201":{"id":"/docs/concepts/places-29","page_id":"/docs/concepts/places","tags":[],"type":"text","url":"/docs/concepts/places#ids-that-last","content":"`tgd:world/…` IDs belong to places in no country: oceans, seas, the world."},"202":{"id":"/docs/concepts/places-30","page_id":"/docs/concepts/places","tags":[],"type":"text","url":"/docs/concepts/places#names-in-every-script","content":"A place carries every name the sources give it: its official name, names in other scripts and\nlanguages, former names and common alternatives. Search reads all of them through a fold that\nignores case, accents and the small spelling differences of each script, and forgives typos,\nso काठमाडौं, Kathmandu and Kathamandu all find the capital. Each country's spelling rules (such as\nचोक written **Chowk**, not Chok) are data in its lexicon,\neach with its source."},"203":{"id":"/docs/concepts/results","page_id":"/docs/concepts/results","type":"page","content":"Results","breadcrumbs":["teigeodata","Concepts"],"tags":[],"url":"/docs/concepts/results"},"204":{"id":"/docs/concepts/results-0","page_id":"/docs/concepts/results","tags":[],"type":"text","url":"/docs/concepts/results","content":"Every query returns its rows as named columns in one compact blob, read in place by the same Reader in every language."},"205":{"id":"/docs/concepts/results-1","page_id":"/docs/concepts/results","type":"heading","tags":[],"url":"/docs/concepts/results#the-same-reader-everywhere","content":"The same Reader everywhere"},"206":{"id":"/docs/concepts/results-2","page_id":"/docs/concepts/results","type":"heading","tags":[],"url":"/docs/concepts/results#place-columns","content":"Place columns"},"207":{"id":"/docs/concepts/results-3","page_id":"/docs/concepts/results","type":"heading","tags":[],"url":"/docs/concepts/results#nulls-numbers-and-strings","content":"Nulls, numbers and strings"},"208":{"id":"/docs/concepts/results-4","page_id":"/docs/concepts/results","type":"heading","tags":[],"url":"/docs/concepts/results#the-format","content":"The format"},"209":{"id":"/docs/concepts/results-5","page_id":"/docs/concepts/results","tags":[],"type":"text","url":"/docs/concepts/results","content":"Every query of the bindings returns its rows as one **result blob**: a few bytes of header, then\neach column stored contiguously. One blob crosses from the engine into your language in a single\ncopy, however many rows it holds, and a `Reader` reads it in place: whole columns as arrays with\nno per-row work, or each row as your language's map or record."},"210":{"id":"/docs/concepts/results-6","page_id":"/docs/concepts/results","tags":[],"type":"text","url":"/docs/concepts/results#the-same-reader-everywhere","content":"Python · reader.rows, reader.columns, has · numbers, strings, nulls, column · iterate: dict","table":"table-0"},"211":{"id":"/docs/concepts/results-7","page_id":"/docs/concepts/results","tags":[],"type":"text","url":"/docs/concepts/results#the-same-reader-everywhere","content":"Node.js, WebAssembly · rows, columns, has · numbers (typed array), strings, nulls, column · iterate: object","table":"table-0"},"212":{"id":"/docs/concepts/results-8","page_id":"/docs/concepts/results","tags":[],"type":"text","url":"/docs/concepts/results#the-same-reader-everywhere","content":"Swift · rows, columns, has · numbers, strings, nulls, column · iterate: Record","table":"table-0"},"213":{"id":"/docs/concepts/results-9","page_id":"/docs/concepts/results","tags":[],"type":"text","url":"/docs/concepts/results#the-same-reader-everywhere","content":"Kotlin and Java · rows(), columns(), has · numbers, strings, nulls, column · iterate: Map","table":"table-0"},"214":{"id":"/docs/concepts/results-10","page_id":"/docs/concepts/results","tags":[],"type":"text","url":"/docs/concepts/results#the-same-reader-everywhere","content":"Dart · rows, columns, has · numbers, strings, nulls, column · iterate: Map","table":"table-0"},"215":{"id":"/docs/concepts/results-11","page_id":"/docs/concepts/results","tags":[],"type":"text","url":"/docs/concepts/results#the-same-reader-everywhere","content":"Go · Rows(), Columns(), Has · Values[T], Strings, Nulls, Column · Records(): map","table":"table-0"},"216":{"id":"/docs/concepts/results-12","page_id":"/docs/concepts/results","tags":[],"type":"text","url":"/docs/concepts/results#the-same-reader-everywhere","content":"C · tg_reader_init, tg_reader_find · tg_reader_string, _number, _int, _is_null","table":"table-0"},"217":{"id":"/docs/concepts/results-13","page_id":"/docs/concepts/results","tags":[],"type":"text","url":"/docs/concepts/results#the-same-reader-everywhere","content":"C++ · rows(), columns(), has · numbers, strings, nulls, column · iterate: Row","table":"table-0"},"218":{"id":"/docs/concepts/results-14","page_id":"/docs/concepts/results","tags":[],"type":"text","url":"/docs/concepts/results#the-same-reader-everywhere","content":".NET · Rows, Columns, Has · Values<T> (span), Strings, Nulls, Column · iterate: dictionary","table":"table-0"},"219":{"id":"/docs/concepts/results-15","page_id":"/docs/concepts/results","tags":[],"type":"text","url":"/docs/concepts/results#the-same-reader-everywhere","content":"Rust's typed engine returns `Place` values instead; `teigeodata-api` gives Rust the blobs too."},"220":{"id":"/docs/concepts/results-16","page_id":"/docs/concepts/results","tags":[],"type":"text","url":"/docs/concepts/results#place-columns","content":"Every query that returns places has these columns:"},"221":{"id":"/docs/concepts/results-17","page_id":"/docs/concepts/results","tags":[],"type":"text","url":"/docs/concepts/results#place-columns","content":"id · string · never","table":"table-1"},"222":{"id":"/docs/concepts/results-18","page_id":"/docs/concepts/results","tags":[],"type":"text","url":"/docs/concepts/results#place-columns","content":"name · string · the place has no name in the languages installed","table":"table-1"},"223":{"id":"/docs/concepts/results-19","page_id":"/docs/concepts/results","tags":[],"type":"text","url":"/docs/concepts/results#place-columns","content":"kind · string · the place's kind is one this reader does not know (a newer pack)","table":"table-1"},"224":{"id":"/docs/concepts/results-20","page_id":"/docs/concepts/results","tags":[],"type":"text","url":"/docs/concepts/results#place-columns","content":"level · integer · never (0 for anything that is not an admin unit)","table":"table-1"},"225":{"id":"/docs/concepts/results-21","page_id":"/docs/concepts/results","tags":[],"type":"text","url":"/docs/concepts/results#place-columns","content":"lat, lon · number (degrees) · never","table":"table-1"},"226":{"id":"/docs/concepts/results-22","page_id":"/docs/concepts/results","tags":[],"type":"text","url":"/docs/concepts/results#place-columns","content":"elevation · integer (metres, EGM2008) · no height is known","table":"table-1"},"227":{"id":"/docs/concepts/results-23","page_id":"/docs/concepts/results","tags":[],"type":"text","url":"/docs/concepts/results#place-columns","content":"parent · string (an ID) · a root (a country, a timezone area), or a pack without the admin hierarchy","table":"table-1"},"228":{"id":"/docs/concepts/results-24","page_id":"/docs/concepts/results","tags":[],"type":"text","url":"/docs/concepts/results#place-columns","content":"tz · string (an IANA zone) · the pack has no timezones there","table":"table-1"},"229":{"id":"/docs/concepts/results-25","page_id":"/docs/concepts/results","tags":[],"type":"text","url":"/docs/concepts/results#place-columns","content":"iso · string (ISO 3166) · the place has no ISO code","table":"table-1"},"230":{"id":"/docs/concepts/results-26","page_id":"/docs/concepts/results","tags":[],"type":"text","url":"/docs/concepts/results#place-columns","content":"population · integer (people) · no count is known, the place is a former unit, or the layer was installed without extra","table":"table-1"},"231":{"id":"/docs/concepts/results-27","page_id":"/docs/concepts/results","tags":[],"type":"text","url":"/docs/concepts/results#place-columns","content":"population_kind · string: stated (a source's count) or modelled (a population grid over an admin unit) · as population","table":"table-1"},"232":{"id":"/docs/concepts/results-28","page_id":"/docs/concepts/results","tags":[],"type":"text","url":"/docs/concepts/results#place-columns","content":"and some queries add their own:"},"233":{"id":"/docs/concepts/results-29","page_id":"/docs/concepts/results","tags":[],"type":"text","url":"/docs/concepts/results#place-columns","content":"search, search_with · score: compares the rows of one query only","table":"table-2"},"234":{"id":"/docs/concepts/results-30","page_id":"/docs/concepts/results","tags":[],"type":"text","url":"/docs/concepts/results#place-columns","content":"reverse, within_radius, nearby · meters (great-circle distance), bearing (degrees clockwise from north, from the place to the point)","table":"table-2"},"235":{"id":"/docs/concepts/results-31","page_id":"/docs/concepts/results","tags":[],"type":"text","url":"/docs/concepts/results#place-columns","content":"postal queries · postal, scheme, code_kind, valid_from, valid_to","table":"table-2"},"236":{"id":"/docs/concepts/results-32","page_id":"/docs/concepts/results","tags":[],"type":"text","url":"/docs/concepts/results#place-columns","content":"Queries that do not return places have their own columns: `elevation_at` (`meters`, `source`,\n`resolution_m`, `datum`), `tz_offset_at` (`seconds`, `dst`, `abbr`), `tz_local` (`kind`,\n`before`, `after`), `tz_zones` (`zone`), `distance` (`meters`, `bearing`), `boundary` (`id`,\n`lod`, `tolerance_m`, `vertices`, `geojson`). The reference lists every query."},"237":{"id":"/docs/concepts/results-33","page_id":"/docs/concepts/results","tags":[],"type":"text","url":"/docs/concepts/results#nulls-numbers-and-strings","content":"**Null is not zero.** A whole number column reads a null row as zero; check `nulls(column)`\n(or read rows, where nulls are your language's null) before trusting a 0."},"238":{"id":"/docs/concepts/results-34","page_id":"/docs/concepts/results","tags":[],"type":"text","url":"/docs/concepts/results#nulls-numbers-and-strings","content":"**Numbers keep their type.** A column is stored as 8, 16, 32 or 64-bit integers or 32 or\n64-bit floats; the readers give each in the language's natural type. 64-bit integers are exact\nto 2^53 where a language has only doubles (JavaScript)."},"239":{"id":"/docs/concepts/results-35","page_id":"/docs/concepts/results","tags":[],"type":"text","url":"/docs/concepts/results#nulls-numbers-and-strings","content":"**Strings are UTF-8,** stored once per distinct value where a column repeats (`kind`, `tz`):\nreading them costs a lookup, not a decode per row."},"240":{"id":"/docs/concepts/results-36","page_id":"/docs/concepts/results","tags":[],"type":"text","url":"/docs/concepts/results#the-format","content":"A blob starts with the magic `TGB1`, the row count, the column count and the total length (16\nbytes), then one 40-byte descriptor per column: its name, type, where its values are, where its\nstrings or dictionary are, and where its null bitmap is. Every offset is checked when the reader\nis made, so no read can leave the blob, even for bytes from an untrusted source. The format is\nspecified in bindings\nand tested in every language against the same fixtures, including malformed blobs each reader\nmust refuse."},"241":{"id":"/docs/concepts/store","page_id":"/docs/concepts/store","type":"page","content":"The store","breadcrumbs":["teigeodata","Concepts"],"tags":[],"url":"/docs/concepts/store"},"242":{"id":"/docs/concepts/store-0","page_id":"/docs/concepts/store","tags":[],"type":"text","url":"/docs/concepts/store","content":"How an app finds, downloads, verifies, updates and removes packs on the user's device, offline once installed."},"243":{"id":"/docs/concepts/store-1","page_id":"/docs/concepts/store","type":"heading","tags":[],"url":"/docs/concepts/store#what-it-does","content":"What it does"},"244":{"id":"/docs/concepts/store-2","page_id":"/docs/concepts/store","type":"heading","tags":[],"url":"/docs/concepts/store#in-code","content":"In code"},"245":{"id":"/docs/concepts/store-3","page_id":"/docs/concepts/store","type":"heading","tags":[],"url":"/docs/concepts/store#in-the-browser","content":"In the browser"},"246":{"id":"/docs/concepts/store-4","page_id":"/docs/concepts/store","type":"heading","tags":[],"url":"/docs/concepts/store#from-the-command-line","content":"From the command line"},"247":{"id":"/docs/concepts/store-5","page_id":"/docs/concepts/store","tags":[],"type":"text","url":"/docs/concepts/store","content":"The **store** keeps the packs installed on a device and the signed **catalog** that says which\npacks exist. It is how an app downloads data when a user needs it: the user searches for\n\"Dubai\", the app finds that the UAE pack holds it, installs that pack, and from then on answers\noffline."},"248":{"id":"/docs/concepts/store-6","page_id":"/docs/concepts/store","tags":[],"type":"text","url":"/docs/concepts/store","content":"Two signed catalogs share one root, because an app chooses its licence once:"},"249":{"id":"/docs/concepts/store-7","page_id":"/docs/concepts/store","tags":[],"type":"text","url":"/docs/concepts/store","content":"**main** (ODbL packs, and the CC BY 4.0 ones a main app also uses):\n`https://raw.githubusercontent.com/teispace/teigeodata/catalog/main/`"},"250":{"id":"/docs/concepts/store-8","page_id":"/docs/concepts/store","tags":[],"type":"text","url":"/docs/concepts/store","content":"**lite** (CC BY 4.0 only): `https://raw.githubusercontent.com/teispace/teigeodata/catalog/lite/`"},"251":{"id":"/docs/concepts/store-9","page_id":"/docs/concepts/store","tags":[],"type":"text","url":"/docs/concepts/store","content":"**Packs** for both: `https://github.com/teispace/teigeodata/releases/download/`"},"252":{"id":"/docs/concepts/store-10","page_id":"/docs/concepts/store","tags":[],"type":"text","url":"/docs/concepts/store","content":"The trust anchor is `1.root.json` from the catalog's directory. Ship it in the app; the store\nfinds every later root by itself. Readers need SDK 1.2 or later. What each catalog holds is on\nthe data page."},"253":{"id":"/docs/concepts/store-11","page_id":"/docs/concepts/store","tags":[],"type":"text","url":"/docs/concepts/store#what-it-does","content":"**Finds packs offline.** `find` takes a name and returns the places it matches with the\ncatalog's packs that hold each one; `locate` does the same for the countries at a point. Both\nread the stored catalog alone, so the app can offer the download, with its size, before it has\na network."},"254":{"id":"/docs/concepts/store-12","page_id":"/docs/concepts/store","tags":[],"type":"text","url":"/docs/concepts/store#what-it-does","content":"**Installs a part.** Install a pack whole, or some components, the names of some languages,\nand boundaries down to a level: the same choices as in packs."},"255":{"id":"/docs/concepts/store-13","page_id":"/docs/concepts/store","tags":[],"type":"text","url":"/docs/concepts/store#what-it-does","content":"**Verifies every byte.** The catalog is signed metadata (TUF): every pack it lists has its\nhead's hash, the head holds every section's hash, and large sections hold a hash per 16 KiB\nblock. Nothing is written before it is checked against that chain, so a bad mirror or a broken\ndownload is refused and the next mirror resumes."},"256":{"id":"/docs/concepts/store-14","page_id":"/docs/concepts/store","tags":[],"type":"text","url":"/docs/concepts/store#what-it-does","content":"**Survives crashes.** An install that a crash or a kill cuts short is finished or undone the\nnext time the store opens; the installed packs are never half-written."},"257":{"id":"/docs/concepts/store-15","page_id":"/docs/concepts/store","tags":[],"type":"text","url":"/docs/concepts/store#what-it-does","content":"**Updates and evicts.** `update` moves installed packs to the catalog's releases, keeping the\ncomponents and languages installed. Where the catalog lists a delta from the installed\nrelease and it costs at most a quarter of the pack, it fetches only the places that changed\nand reads them above the installed pack; otherwise it fetches the sections that changed. Pinned packs are kept when room is made; `remove` takes a\npack out with the dependencies nothing else needs."},"258":{"id":"/docs/concepts/store-16","page_id":"/docs/concepts/store","tags":[],"type":"text","url":"/docs/concepts/store#what-it-does","content":"**Gives you an engine.** `engine()` opens every installed pack, with the parts installed."},"259":{"id":"/docs/concepts/store-17","page_id":"/docs/concepts/store","tags":[],"type":"text","url":"/docs/concepts/store#in-code","content":"The store's calls block on the network and the disk, so call them off the UI thread or use the\nlanguage's asynchronous form (`…Async` in Swift, Kotlin and Java, Dart, Node.js and .NET; `aio`\nin Python). An install runs as a `Job` that reports its bytes as it goes and can be cancelled:\ncancelled, it leaves the store as it was."},"260":{"id":"/docs/concepts/store-18","page_id":"/docs/concepts/store","tags":[],"type":"text","url":"/docs/concepts/store#in-code","content":"On iOS and Android a download may need to go on while the app is suspended. `install_pass`\nsplits an install so the platform's own download service fetches the bytes (a background\n`URLSession`, `WorkManager`): each pass lists the byte ranges still missing, the platform fetches\nthem into files, and the next pass verifies and installs what arrived."},"261":{"id":"/docs/concepts/store-19","page_id":"/docs/concepts/store","tags":[],"type":"text","url":"/docs/concepts/store#in-the-browser","content":"`teigeodata-wasm/store` is the same store in a page's origin: the same journal, recovery,\nsigned catalog and resumable installs, with the files in the origin private file system (OPFS)\nand the network through `fetch`. It is its own module inside the `teigeodata-wasm` package, so\na page that only reads packs never loads it."},"262":{"id":"/docs/concepts/store-20","page_id":"/docs/concepts/store","tags":[],"type":"text","url":"/docs/concepts/store#in-the-browser","content":"The store writes from a dedicated Web Worker, `store-worker.js`, since only a worker can write\nOPFS files at an offset. Any page or worker reads what it installed, with any engine:"},"263":{"id":"/docs/concepts/store-21","page_id":"/docs/concepts/store","tags":[],"type":"text","url":"/docs/concepts/store#in-the-browser","content":"**Lazy by section.** `openInstalled` reads each pack's head, then only the sections of the\ncomponents installed, each checked against the head."},"264":{"id":"/docs/concepts/store-22","page_id":"/docs/concepts/store","tags":[],"type":"text","url":"/docs/concepts/store#in-the-browser","content":"**Files in use are kept.** A reader holds a shared Web Lock on each file it has open. A\nremoval or an update leaves such a file until it is let go, and the next call removes it."},"265":{"id":"/docs/concepts/store-23","page_id":"/docs/concepts/store","tags":[],"type":"text","url":"/docs/concepts/store#in-the-browser","content":"**One writer at a time.** Each call runs under the store's Web Lock on a store opened afresh,\nso tabs share one store and each sees the others' installs."},"266":{"id":"/docs/concepts/store-24","page_id":"/docs/concepts/store","tags":[],"type":"text","url":"/docs/concepts/store#in-the-browser","content":"**Mirrors on another origin** must allow it (CORS) and expose `Content-Range` and `ETag`.\nRange requests need no preflight. See running a mirror."},"267":{"id":"/docs/concepts/store-25","page_id":"/docs/concepts/store","tags":[],"type":"text","url":"/docs/concepts/store#from-the-command-line","content":"`tgd init`, `refresh`, `catalog`, `find`, `locate`, `install`, `update`, `remove`, `pin`,\n`status` and `repair` do the same from a shell; see the command line.\n`tgd serve` and `tgd mcp` follow the store: a pack installed or updated while they run is\nanswered from within seconds."},"268":{"id":"/docs/data/countries/in","page_id":"/docs/data/countries/in","type":"page","content":"India","breadcrumbs":["teigeodata","Data","Countries"],"tags":[],"url":"/docs/data/countries/in"},"269":{"id":"/docs/data/countries/in-0","page_id":"/docs/data/countries/in","tags":[],"type":"text","url":"/docs/data/countries/in","content":"What teigeodata holds for India: its places, admin levels, heights, timezones, names and sources."},"270":{"id":"/docs/data/countries/in-1","page_id":"/docs/data/countries/in","type":"heading","tags":[],"url":"/docs/data/countries/in#in-the-pack","content":"In the pack"},"271":{"id":"/docs/data/countries/in-2","page_id":"/docs/data/countries/in","type":"heading","tags":[],"url":"/docs/data/countries/in#admin-levels","content":"Admin levels"},"272":{"id":"/docs/data/countries/in-3","page_id":"/docs/data/countries/in","type":"heading","tags":[],"url":"/docs/data/countries/in#heights-and-timezones","content":"Heights and timezones"},"273":{"id":"/docs/data/countries/in-4","page_id":"/docs/data/countries/in","type":"heading","tags":[],"url":"/docs/data/countries/in#names","content":"Names"},"274":{"id":"/docs/data/countries/in-5","page_id":"/docs/data/countries/in","type":"heading","tags":[],"url":"/docs/data/countries/in#lexicon","content":"Lexicon"},"275":{"id":"/docs/data/countries/in-6","page_id":"/docs/data/countries/in","type":"heading","tags":[],"url":"/docs/data/countries/in#sources","content":"Sources"},"276":{"id":"/docs/data/countries/in-7","page_id":"/docs/data/countries/in","tags":[],"type":"text","url":"/docs/data/countries/in","content":"This page is written by `cargo xtask data-pages` from `data/countries/in` and the pack the site's\nexamples run on (`world-np-lite.tgd`, data release `data-2026.11.14.3`), and CI fails when it differs. It changes with\neach release."},"277":{"id":"/docs/data/countries/in-8","page_id":"/docs/data/countries/in","tags":[],"type":"text","url":"/docs/data/countries/in#in-the-pack","content":"`world-np-lite.tgd` holds **8,111 places** in India: those whose country in the hierarchy is India,\nas disputed borders are drawn. Their IDs begin `tgd:in/`,\nexcept places a disputed border moved, which keep the ID they were first given."},"278":{"id":"/docs/data/countries/in-9","page_id":"/docs/data/countries/in","tags":[],"type":"text","url":"/docs/data/countries/in#in-the-pack","content":"Country · 1 · 0.0%","table":"table-0"},"279":{"id":"/docs/data/countries/in-10","page_id":"/docs/data/countries/in","tags":[],"type":"text","url":"/docs/data/countries/in#in-the-pack","content":"Admin units · 800 · 0.0%","table":"table-0"},"280":{"id":"/docs/data/countries/in-11","page_id":"/docs/data/countries/in","tags":[],"type":"text","url":"/docs/data/countries/in#in-the-pack","content":"Settlements · 7,310 · 100.0%","table":"table-0"},"281":{"id":"/docs/data/countries/in-12","page_id":"/docs/data/countries/in","tags":[],"type":"text","url":"/docs/data/countries/in#admin-levels","content":"The ladder is the country's own, from its profile. The counts are the admin places of each level\nin the pack: the current units, and former ones kept so their names still resolve (only current\nunits have an ISO code)."},"282":{"id":"/docs/data/countries/in-13","page_id":"/docs/data/countries/in","tags":[],"type":"text","url":"/docs/data/countries/in#admin-levels","content":"0 · Country · 1 · 1","table":"table-1"},"283":{"id":"/docs/data/countries/in-14","page_id":"/docs/data/countries/in","tags":[],"type":"text","url":"/docs/data/countries/in#admin-levels","content":"1 · State or union territory · 38 · 36","table":"table-1"},"284":{"id":"/docs/data/countries/in-15","page_id":"/docs/data/countries/in","tags":[],